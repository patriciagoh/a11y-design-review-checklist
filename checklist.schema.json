{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/<github-username>/a11y-design-review-checklist/checklist.schema.json",
  "title": "a11y-design-review-checklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "wcag_version", "conformance_level", "released_at", "items"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "wcag_version": { "const": "2.2" },
    "conformance_level": { "enum": ["A", "AA"] },
    "released_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "wcag_criterion", "wcag_title", "level", "category", "title", "description", "how_to_test", "pass_criteria", "fail_examples", "tags"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+-[a-z0-9-]+$"
        },
        "wcag_criterion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "wcag_title": { "type": "string" },
        "level": { "enum": ["A", "AA"] },
        "category": {
          "enum": ["perceivable", "operable", "understandable", "robust", "dynamic_collaborative"]
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "how_to_test": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "pass_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fail_examples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" }
            }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "annotations",
              "navigation",
              "zoom-pan",
              "focus",
              "keyboard",
              "live-regions",
              "versioning",
              "threads",
              "roles",
              "workflow-state",
              "realtime",
              "contrast",
              "target-size",
              "motion",
              "forms",
              "media",
              "language",
              "name-role-value"
            ]
          }
        }
      }
    }
  }
}
