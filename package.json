{
  "name": "a11y-design-review-checklist",
  "version": "1.1.1",
  "description": "WCAG 2.2 AA accessibility checklist for design-review UI patterns (annotations, threads, versioning, workflows, real-time collaboration). Machine-readable JSON + generated Markdown.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag-2.2",
    "checklist",
    "design-review",
    "annotations",
    "audit"
  ],
  "license": "MIT",
  "author": "Patricia Goh",
  "homepage": "https://github.com/patriciagoh/a11y-design-review-checklist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patriciagoh/a11y-design-review-checklist.git"
  },
  "bugs": {
    "url": "https://github.com/patriciagoh/a11y-design-review-checklist/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./checklist.json": "./checklist.json",
    "./checklist.schema.json": "./checklist.schema.json"
  },
  "files": [
    "checklist.json",
    "checklist.schema.json",
    "checklist.md",
    "index.js",
    "index.html",
    "validate.js",
    "generate-pr-comment.js",
    "scripts/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "a11y-design-review-checklist-validate": "./validate.js",
    "a11y-design-review-checklist-pr-comment": "./generate-pr-comment.js"
  },
  "scripts": {
    "validate": "node validate.js",
    "generate-md": "node scripts/generate-markdown.js",
    "check-md": "node scripts/generate-markdown.js --check",
    "pr-comment": "node generate-pr-comment.js",
    "test": "node --test tests/",
    "prepublishOnly": "npm run validate && npm run check-md && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
