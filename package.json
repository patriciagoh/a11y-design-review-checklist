{
  "name": "a11y-design-review-checklist",
  "version": "1.2.0",
  "private": true,
  "description": "WCAG 2.2 AA accessibility checklist for design-review UI patterns (annotations, threads, versioning, workflows, real-time collaboration). Distributed via GitHub + Pages — not published to npm.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag-2.2",
    "checklist",
    "design-review",
    "annotations",
    "audit"
  ],
  "license": "MIT",
  "author": "Patricia Goh",
  "homepage": "https://patriciagoh.github.io/a11y-design-review-checklist/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patriciagoh/a11y-design-review-checklist.git"
  },
  "bugs": {
    "url": "https://github.com/patriciagoh/a11y-design-review-checklist/issues"
  },
  "type": "module",
  "scripts": {
    "validate": "node validate.js",
    "generate-md": "node scripts/generate-markdown.js",
    "check-md": "node scripts/generate-markdown.js --check",
    "pr-comment": "node generate-pr-comment.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
